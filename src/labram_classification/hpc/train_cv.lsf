#!/usr/bin/env bash
#BSUB -J braindecode_cv
#BSUB -o outputs/braindecode_cv_%J.out
#BSUB -e errors/braindecode_cv_%J.err
#BSUB -n 4
#BSUB -q gpuv100
#BSUB -R "select[model==XeonGold6142]"
#BSUB -gpu 'num=1:mode=exclusive_process'
#BSUB -W 16:00
#BSUB -R 'rusage[mem=10GB]'
#BSUB -R 'span[hosts=1]'
#BSUB -N

set -euo pipefail
: "${PROJECT_DIR:?Export the absolute project directory before submitting}"
: "${VENV:?Export the absolute Python virtual environment directory}"
: "${CACHE_DIR:?Export the absolute prepared cache directory}"
: "${OUTPUT_DIR:?Export a NEW absolute cross-validation output directory}"

module load cuda/11.8
source "$VENV/bin/activate"
cd "$PROJECT_DIR"
export PYTHONPATH="$PROJECT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
export OMP_NUM_THREADS=4
export HF_HUB_OFFLINE=1
export WANDB_MODE="${WANDB_MODE:-offline}"
export WANDB_PROJECT="${WANDB_PROJECT:-labram-classification}"
export WANDB_RUN_GROUP="${WANDB_RUN_GROUP:-$(basename "$OUTPUT_DIR")}"
nvidia-smi
python -m labram_classification cv \
    --cache "$CACHE_DIR" \
    --output "$OUTPUT_DIR" \
    --checkpoint "${CHECKPOINT:-$PROJECT_DIR/models/labram-base.pth}" \
    --batch-size 128 --update-freq 2 \
    --warmup-epochs 5 --epochs 10 --layer-decay 0.65 \
    --weight-decay 0.05 --drop-path 0.2 --seed 0 --num-workers 4 --device cuda
